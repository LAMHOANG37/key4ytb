# Optional. The default YouTube.js source does not need a key.
# For the official API, enable YouTube Data API v3 and copy to .env.
YOUTUBE_API_KEY=
PORT=4173
# Keyword research: optional persistent environment configuration.
# Set the key here for local use. Never commit your .env file.
VIDIQ_API_KEY=
# Set to 1 to prevent removing the configured key through the app.
VIDIQ_KEY_LOCKED=0
RESEARCH_AI_PROVIDER=ollama
RESEARCH_AI_MODEL=qwen3:4b
# Only needed if selecting OpenAI instead of local Ollama:
OPENAI_API_KEY=
